{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://runtime-feature-falsifier.dev/schema/artifact-reference.schema.json",
  "title": "Runtime Feature Falsifier artifact reference",
  "type": "object",
  "required": [
    "path"
  ],
  "properties": {
    "path": {
      "type": "string",
      "minLength": 1
    },
    "sha256": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9a-f]{64}$"
    },
    "kind": {
      "type": "string",
      "minLength": 1
    }
  },
  "additionalProperties": false
}
